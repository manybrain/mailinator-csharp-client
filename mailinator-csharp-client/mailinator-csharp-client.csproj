<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net471;netstandard2.0</TargetFrameworks>
    <RootNamespace>mailinator_csharp_client</RootNamespace>
    <PackageId>MailinatorApiClient</PackageId>
    <Company>Manybrain, LLC</Company>
    <RepositoryUrl>https://github.com/manybrain/mailinator-csharp-client</RepositoryUrl>
    <Description>Client Library used to interact with the Mailinator API</Description>
    <PackageProjectUrl></PackageProjectUrl>
    <Copyright>© Manybrain 2026</Copyright>
    <Authors>Marian Melnychuk</Authors>
    <PackageTags>Manybrain; ApiClient</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
    <Product>MailinatorApiClient</Product>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0</FileVersion>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="RestSharp" Version="114.0.0" />
	<PackageReference Include="System.Text.Json" Version="10.0.11" />
	<None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
